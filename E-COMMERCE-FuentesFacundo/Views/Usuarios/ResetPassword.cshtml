@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Resetear contraseña";
}

<h1>Resetear contraseña</h1>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>@Model.Email</strong></p>
        <p class="text-muted mb-0">Se establecerá una nueva contraseña para este usuario.</p>
    </div>
</div>

<form asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="IdUsuario" />
    <input type="hidden" asp-for="Email" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="NuevaPassword" class="control-label"></label>
        <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NuevaPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ConfirmarPassword" class="control-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">Restablecer contraseña</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
