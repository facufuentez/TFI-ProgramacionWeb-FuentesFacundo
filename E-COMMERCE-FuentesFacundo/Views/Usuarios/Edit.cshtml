@model UsuarioRolesViewModel

@{
    ViewData["Title"] = "Editar roles";
}

<h1>Editar roles</h1>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>@Model.NombreCompleto</strong></p>
        <p class="text-muted mb-0">@Model.Email</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdUsuario" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Roles</label>
        @for (var i = 0; i < Model.RolesDisponibles.Count; i++)
        {
            var rol = Model.RolesDisponibles[i];
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="RolesSeleccionados" value="@rol" id="rol_@i"
                       checked="@(Model.RolesSeleccionados.Contains(rol) ? "checked" : null)" />
                <label class="form-check-label" for="rol_@i">@rol</label>
            </div>
        }
        <span asp-validation-for="RolesSeleccionados" class="text-danger"></span>
        <div class="form-text">
            Un usuario debe tener al menos un rol. No se puede quitar el último Administrador del sistema.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
