@model E_COMMERCE_FuentesFacundo.Models.ViewModels.MetodoEntregaViewModel

@{
    ViewData["Title"] = "Editar Método de Entrega";
}

<h1>Editar Método de Entrega</h1>

<h4>Método de Entrega</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdMetodoEntrega" />
            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Costo" class="control-label"></label>
                <input asp-for="Costo" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Costo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
