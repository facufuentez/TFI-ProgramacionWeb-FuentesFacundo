@model E_COMMERCE_FuentesFacundo.Models.Entities.MetodoEntrega

@{
    ViewData["Title"] = "Detalles del Método de Entrega";
}

<h1>Detalles</h1>

<div>
    <h4>Método de Entrega</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Costo)
        </dt>
        <dd class="col-sm-10">
            @Model.Costo.ToString("C")
        </dd>
        <dt class="col-sm-2">
            Pedidos
        </dt>
        <dd class="col-sm-10">
            @Model.Pedidos.Count
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdMetodoEntrega" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>
