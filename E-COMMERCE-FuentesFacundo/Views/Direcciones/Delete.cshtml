@model E_COMMERCE_FuentesFacundo.Models.Entities.Direccion

@{
    ViewData["Title"] = "Desactivar dirección";
}

<h1>Mi cuenta</h1>

<partial name="_AccountNav" />

<h3>Desactivar dirección</h3>
<p>La dirección quedará desactivada y no estará disponible para futuros pedidos, pero se conservará en tu historial.</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">Calle</dt>
        <dd class="col-sm-10">@Model.Calle</dd>
        <dt class="col-sm-2">Número</dt>
        <dd class="col-sm-10">@Model.Numero</dd>
        <dt class="col-sm-2">Ciudad</dt>
        <dd class="col-sm-10">@Model.Ciudad</dd>
        <dt class="col-sm-2">Código Postal</dt>
        <dd class="col-sm-10">@Model.CodigoPostal</dd>
        <dt class="col-sm-2">Provincia</dt>
        <dd class="col-sm-10">@(Model.Provincia?.Nombre ?? "-")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdDireccion" />
        <input type="submit" value="Desactivar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver a Mis direcciones</a>
    </form>
</div>
