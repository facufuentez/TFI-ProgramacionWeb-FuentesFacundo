@model IEnumerable<E_COMMERCE_FuentesFacundo.Models.Entities.Pedido>

@{
    ViewData["Title"] = "Mis pedidos";
}

<h1>Mis pedidos</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no realizaste ningún pedido.</div>
    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">Ver productos</a>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nº</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Entrega</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var pedido in Model)
        {
            var total = pedido.DetallesPedido.Sum(d => d.Cantidad * d.PrecioUnitario) + pedido.CostoEnvio;
            <tr>
                <td>#@pedido.IdPedido</td>
                <td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(pedido.EstadoPedido?.Nombre ?? "-")</td>
                <td>@(pedido.MetodoEntrega?.Nombre ?? "-")</td>
                <td>$@total.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pedido.IdPedido" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Comprobante" asp-route-id="@pedido.IdPedido" class="btn btn-danger btn-sm">PDF</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
