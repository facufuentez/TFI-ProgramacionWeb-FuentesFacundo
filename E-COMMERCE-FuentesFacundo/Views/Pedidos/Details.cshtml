@model E_COMMERCE_FuentesFacundo.Models.Entities.Pedido

@{
    ViewData["Title"] = "Pedido #" + Model.IdPedido;
    var subtotal = Model.DetallesPedido.Sum(d => d.Cantidad * d.PrecioUnitario);
    var total = subtotal + Model.CostoEnvio;
    var pago = Model.Pagos.OrderByDescending(p => p.IdPago).FirstOrDefault();
    var transferenciaPendiente = pago != null
        && pago.MetodoPago == "Transferencia por QR"
        && pago.EstadoPago == "Pendiente";
}

<h1>Pedido #@Model.IdPedido</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (transferenciaPendiente)
{
    <div class="alert alert-info">
        <strong>Transferencia por QR pendiente.</strong>
        Realizá la transferencia por el total de <strong>$@total.ToString("N2")</strong> usando el siguiente QR.
        El pedido se confirmará cuando el administrador verifique el pago.
        <div class="mt-3">
            <img src="~/images/qr-transferencia.png" alt="QR de transferencia" style="max-width: 220px;" class="img-fluid border rounded" />
        </div>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <h4>Productos</h4>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio unitario</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var detalle in Model.DetallesPedido)
            {
                <tr>
                    <td>@(detalle.Producto?.Nombre ?? "-")</td>
                    <td>$@detalle.PrecioUnitario.ToString("N2")</td>
                    <td>@detalle.Cantidad</td>
                    <td>$@((detalle.Cantidad * detalle.PrecioUnitario).ToString("N2"))</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Subtotal</th>
                    <th>$@subtotal.ToString("N2")</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Envío</th>
                    <th>$@Model.CostoEnvio.ToString("N2")</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>$@total.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Resumen</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Estado</dt>
                    <dd class="col-7">@(Model.EstadoPedido?.Nombre ?? "-")</dd>
                    <dt class="col-5">Fecha</dt>
                    <dd class="col-7">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-5">Entrega</dt>
                    <dd class="col-7">@(Model.MetodoEntrega?.Nombre ?? "-")</dd>
                    <dt class="col-5">Costo envío</dt>
                    <dd class="col-7">$@Model.CostoEnvio.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Dirección de envío</div>
            <div class="card-body">
                @if (Model.DireccionEnvio != null)
                {
                    <div>@Model.DireccionEnvio.Calle @Model.DireccionEnvio.Numero</div>
                    <div>@Model.DireccionEnvio.Ciudad, @(Model.DireccionEnvio.Provincia?.Nombre ?? "-")</div>
                    <div>CP: @Model.DireccionEnvio.CodigoPostal</div>
                }
                else
                {
                    <span class="text-muted">Sin datos</span>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Pago</div>
            <div class="card-body">
                @if (pago != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-5">Medio</dt>
                        <dd class="col-7">@pago.MetodoPago</dd>
                        <dt class="col-5">Estado</dt>
                        <dd class="col-7">@pago.EstadoPago</dd>
                        <dt class="col-5">Monto</dt>
                        <dd class="col-7">$@pago.Monto.ToString("N2")</dd>
                        @if (pago.MetodoPago == "Mercado Pago" && !string.IsNullOrWhiteSpace(pago.IdMercadoPago))
                        {
                            <dt class="col-5">ID MP</dt>
                            <dd class="col-7">@pago.IdMercadoPago</dd>
                        }
                    </dl>
                }
                else
                {
                    <span class="text-muted">Sin datos</span>
                }
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Volver a mis pedidos</a>
    <a asp-action="Comprobante" asp-route-id="@Model.IdPedido" class="btn btn-danger">Descargar comprobante PDF</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Seguir comprando</a>
</div>
