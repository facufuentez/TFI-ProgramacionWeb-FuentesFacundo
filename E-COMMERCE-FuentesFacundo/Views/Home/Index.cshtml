@model HomeIndexViewModel

@{
    ViewData["Title"] = "Catálogo";

    var paginacion = new PaginationViewModel
    {
        PageIndex = Model.Productos.PageIndex,
        TotalPages = Model.Productos.TotalPages,
        HasPreviousPage = Model.Productos.HasPreviousPage,
        HasNextPage = Model.Productos.HasNextPage,
        Action = "Index",
        Controller = "Home",
        RouteValues = new Dictionary<string, string?>
        {
            ["q"] = Model.Busqueda
        }
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
   
    @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
    {
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar búsqueda</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Busqueda))
{
    <p class="text-muted mt-2">Resultados para «@Model.Busqueda» (@Model.Productos.TotalCount).</p>
}

@if (Model.CarruselProductos.Any())
{
    <div id="catalogoCarousel" class="carousel slide mb-4 product-carousel" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < Model.CarruselProductos.Count; i++)
            {
                <button type="button" data-bs-target="#catalogoCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
            }
        </div>
        <div class="carousel-inner rounded shadow-sm">
            @for (int i = 0; i < Model.CarruselProductos.Count; i++)
            {
                var producto = Model.CarruselProductos[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <a asp-controller="Productos" asp-action="Details" asp-route-id="@producto.IdProducto">
                        <img src="@producto.ImagenUrl" class="d-block w-100" alt="@producto.Nombre" style="height: 100%; object-fit: contain; background: transparent;">
                    </a>
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded px-3 py-2">
                        <h5 class="mb-0">@producto.Nombre</h5>
                        <small>@(producto.Categoria?.Nombre ?? "-")</small>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#catalogoCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#catalogoCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
}

@if (!Model.Productos.Any())
{
    <div class="alert alert-info mt-3">
        @(string.IsNullOrWhiteSpace(Model.Busqueda)
            ? "No hay productos disponibles."
            : "No se encontraron productos para la búsqueda.")
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-1">
        @foreach (var producto in Model.Productos)
        {
            <div class="col">
                @await Html.PartialAsync("_ProductoCard", producto)
            </div>
        }
    </div>

    <partial name="_Pagination" model="paginacion" />
}
