@model E_COMMERCE_FuentesFacundo.Models.Entities.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<h1>Detalles</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div>
    <h4>Producto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Precio)
        </dt>
        <dd class="col-sm-10">
            $@Model.Precio.ToString("N2")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Stock)
        </dt>
        <dd class="col-sm-10">
            @if (User.IsInRole("Administrador"))
            {
                @Model.Stock
            }
            else
            {
                @(Model.Stock > 0 ? "En stock" : "Sin stock")
            }
        </dd>
        <dt class="col-sm-2">
            Imagen
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl" alt="@Model.Nombre" style="max-width: 300px; max-height: 300px;" />
            }
            else
            {
                <span>Sin imagen</span>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Activo)
        </dt>
        <dd class="col-sm-10">
            @(Model.Activo ? "Sí" : "No")
        </dd>
        <dt class="col-sm-2">
            Categoría
        </dt>
        <dd class="col-sm-10">
            @(Model.Categoria?.Nombre ?? "-")
        </dd>
    </dl>
</div>
<div class="mb-3">
    @if (Model.Activo && Model.Stock > 0)
    {
        <form asp-controller="Carrito" asp-action="Add" method="post" class="row row-cols-lg-auto g-2 align-items-center">
            <input type="hidden" name="idProducto" value="@Model.IdProducto" />
            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
            <div class="col-12">
                <input type="number" name="cantidad" value="1" min="1" max="@Model.Stock" class="form-control" style="width: 100px;" aria-label="Cantidad" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success">Agregar al carrito</button>
            </div>
        </form>
    }
    else if (Model.Activo)
    {
        <span class="badge bg-secondary">Sin stock</span>
    }
    else
    {
        <span class="badge bg-secondary">Producto inactivo</span>
    }
</div>

<div>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn btn-warning">Editar</a> 
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>
