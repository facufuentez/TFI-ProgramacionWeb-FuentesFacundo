@model IEnumerable<E_COMMERCE_FuentesFacundo.Models.Entities.Producto>

@{
    ViewData["Title"] = "Productos";
    ViewData["ShowAdminActions"] = true;
}

<h1>Productos</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Producto</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay productos registrados.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var producto in Model)
        {
            <div class="col">
                @await Html.PartialAsync("_ProductoCard", producto)
            </div>
        }
    </div>
}
