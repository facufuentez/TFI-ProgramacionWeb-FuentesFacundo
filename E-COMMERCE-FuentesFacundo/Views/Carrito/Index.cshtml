@model CartViewModel

@{
    ViewData["Title"] = "Carrito";
}

<h1>Carrito</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Tu carrito está vacío.</div>
    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">Ver productos</a>
}
else
{
    @if (Model.TieneProblemas)
    {
        <div class="alert alert-warning">
            Hay productos con stock insuficiente o no disponibles. Ajustá las cantidades o quitálos antes de finalizar la compra.
        </div>
    }

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio</th>
                <th style="width: 180px;">Cantidad</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                        {
                            <img src="@item.ImagenUrl" alt="@item.Nombre" style="width: 60px; height: 60px; object-fit: cover;" class="me-2 rounded" />
                        }
                        <div>
                            <div>@item.Nombre</div>
                            @if (!item.Activo)
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                            else if (item.Stock <= 0)
                            {
                                <span class="badge bg-danger">Sin stock</span>
                            }
                            else if (item.StockInsuficiente)
                            {
                                <span class="badge bg-warning text-dark">Solo quedan @item.Stock</span>
                            }
                        </div>
                    </div>
                </td>
                <td>$@item.Precio.ToString("N2")</td>
                <td>
                    <form asp-action="Update" method="post" class="d-flex">
                        <input type="hidden" name="idProducto" value="@item.IdProducto" />
                        <input type="number" name="cantidad" value="@item.Cantidad" min="0" max="@item.Stock" class="form-control form-control-sm" style="width: 80px;" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm ms-1">Actualizar</button>
                    </form>
                </td>
                <td>$@item.Subtotal.ToString("N2")</td>
                <td>
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="idProducto" value="@item.IdProducto" />
                        <button type="submit" class="btn btn-danger btn-sm">Quitar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Subtotal</th>
                <th>$@Model.Subtotal.ToString("N2")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-danger">Vaciar carrito</button>
        </form>
        <div>
            <a asp-controller="Home" asp-action="Index" 
class="btn btn-secondary">Seguir comprando</a>
            @if (Model.TieneProblemas)
            {
                <button type="button" class="btn btn-success" disabled>Finalizar compra</button>
            }
            else
            {
                <a asp-action="Checkout" class="btn btn-success">Finalizar compra</a>
            }
        </div>
    </div>
}
