@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var profileActive = currentController == "Account" && currentAction == "Profile" ? "active" : "";
    var changePasswordActive = currentController == "Account" && currentAction == "ChangePassword" ? "active" : "";
    var direccionesActive = currentController == "Direcciones" ? "active" : "";
    var pedidosActive = currentController == "Pedidos" ? "active" : "";
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @profileActive" asp-controller="Account" asp-action="Profile">Datos personales</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @changePasswordActive" asp-controller="Account" asp-action="ChangePassword">Cambiar contraseña</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @direccionesActive" asp-controller="Direcciones" asp-action="Index">Mis direcciones</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @pedidosActive" asp-controller="Pedidos" asp-action="Index">Mis pedidos</a>
    </li>
</ul>
