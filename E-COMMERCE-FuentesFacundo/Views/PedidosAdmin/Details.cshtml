@using E_COMMERCE_FuentesFacundo.Models.Entities
@model Pedido

@{
    ViewData["Title"] = "Pedido #" + Model.IdPedido;

    var subtotal = Model.DetallesPedido.Sum(d => d.Cantidad * d.PrecioUnitario);
    var total = subtotal + Model.CostoEnvio;
    var pago = Model.Pagos.OrderByDescending(p => p.IdPago).FirstOrDefault();
    var actual = ViewBag.EstadoActual as string ?? string.Empty;
    var siguientes = ViewBag.Siguientes as List<EstadoPedido> ?? new List<EstadoPedido>();

    var cancelado = string.Equals(actual, "Cancelado", StringComparison.OrdinalIgnoreCase);
    var pagoAprobado = pago != null && string.Equals(pago.EstadoPago, "Aprobado", StringComparison.OrdinalIgnoreCase);
    var puedeConfirmar = pago != null && !pagoAprobado && !cancelado;
    var puedeRechazar = pago != null && !cancelado
        && (string.Equals(actual, "Pendiente", StringComparison.OrdinalIgnoreCase)
            || string.Equals(actual, "Pagado", StringComparison.OrdinalIgnoreCase));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Pedido #@Model.IdPedido</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Pedidos" asp-action="Comprobante" asp-route-id="@Model.IdPedido" class="btn btn-danger">Comprobante PDF</a>
        <a asp-action="Index" class="btn btn-secondary">Volver a pedidos</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        <h4>Productos</h4>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio unitario</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var detalle in Model.DetallesPedido)
            {
                <tr>
                    <td>@(detalle.Producto?.Nombre ?? "-")</td>
                    <td>$@detalle.PrecioUnitario.ToString("N2")</td>
                    <td>@detalle.Cantidad</td>
                    <td>$@((detalle.Cantidad * detalle.PrecioUnitario).ToString("N2"))</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Subtotal</th>
                    <th>$@subtotal.ToString("N2")</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Envío</th>
                    <th>$@Model.CostoEnvio.ToString("N2")</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>$@total.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>

        <div class="card mb-3">
            <div class="card-header">Datos del cliente</div>
            <div class="card-body">
                @if (Model.Usuario != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-4">Nombre</dt>
                        <dd class="col-8">@Model.Usuario.Nombre @Model.Usuario.Apellido</dd>
                        <dt class="col-4">Email</dt>
                        <dd class="col-8">@Model.Usuario.Email</dd>
                        <dt class="col-4">Teléfono</dt>
                        <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.Usuario.PhoneNumber) ? "-" : Model.Usuario.PhoneNumber)</dd>
                    </dl>
                }
                else
                {
                    <span class="text-muted">Sin datos</span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Gestión del pedido</div>
            <div class="card-body">
                <p class="mb-2">
                    Estado actual:
                    <strong>@(Model.EstadoPedido?.Nombre ?? "-")</strong>
                </p>

                @if (siguientes.Any())
                {
                    <form asp-action="CambiarEstado" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.IdPedido" />
                        <div class="input-group">
                            <select name="idEstado" class="form-select" aria-label="Nuevo estado">
                                @foreach (var estado in siguientes)
                                {
                                    <option value="@estado.IdEstadoPedido">@estado.Nombre</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">Cambiar</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted mb-2">No hay cambios de estado disponibles.</p>
                }

                <div class="d-flex gap-2 flex-wrap">
                    @if (puedeConfirmar)
                    {
                        <form asp-action="ConfirmarPago" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.IdPedido" />
                            <button type="submit" class="btn btn-success btn-sm">Confirmar pago</button>
                        </form>
                    }

                    @if (puedeRechazar)
                    {
                        <form asp-action="RechazarPago" method="post" class="m-0"
                              onsubmit="return confirm('¿Rechazar el pago y cancelar el pedido? Se repondrá el stock.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.IdPedido" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Rechazar pago</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Resumen</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Estado</dt>
                    <dd class="col-7">@(Model.EstadoPedido?.Nombre ?? "-")</dd>
                    <dt class="col-5">Fecha</dt>
                    <dd class="col-7">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-5">Entrega</dt>
                    <dd class="col-7">@(Model.MetodoEntrega?.Nombre ?? "-")</dd>
                    <dt class="col-5">Costo envío</dt>
                    <dd class="col-7">$@Model.CostoEnvio.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Dirección de envío</div>
            <div class="card-body">
                @if (Model.DireccionEnvio != null)
                {
                    <div>@Model.DireccionEnvio.Calle @Model.DireccionEnvio.Numero</div>
                    <div>@Model.DireccionEnvio.Ciudad, @(Model.DireccionEnvio.Provincia?.Nombre ?? "-")</div>
                    <div>CP: @Model.DireccionEnvio.CodigoPostal</div>
                }
                else
                {
                    <span class="text-muted">Sin datos</span>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Pago</div>
            <div class="card-body">
                @if (pago != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-5">Medio</dt>
                        <dd class="col-7">@pago.MetodoPago</dd>
                        <dt class="col-5">Estado</dt>
                        <dd class="col-7">@pago.EstadoPago</dd>
                        <dt class="col-5">Monto</dt>
                        <dd class="col-7">$@pago.Monto.ToString("N2")</dd>
                        <dt class="col-5">Fecha pago</dt>
                        <dd class="col-7">@(pago.FechaPago?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    </dl>
                }
                else
                {
                    <span class="text-muted">Sin datos</span>
                }
            </div>
        </div>
    </div>
</div>
